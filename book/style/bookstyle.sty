\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/bookstyle}
% Page: 8.5 x 11 in textbook trim, binding-aware margins
\RequirePackage[letterpaper,inner=1in,outer=1.1in,top=0.95in,bottom=1in,headsep=0.3in,footskip=0.45in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{tgpagella}
\RequirePackage[sc]{mathpazo}
\RequirePackage[scale=0.92]{tgheros}
\RequirePackage{tgcursor}
\linespread{1.08}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage[per-mode=symbol]{siunitx}
\sisetup{range-phrase=--}
\DeclareSIUnit\cmH{cm\,H_2O}
\DeclareSIUnit\mmHg{mmHg}
\DeclareSIUnit\breath{breath}
\RequirePackage{graphicx}
\graphicspath{{figures/}}
\RequirePackage{booktabs,array,tabularx}
\RequirePackage{caption,subcaption}
\captionsetup{font=small,labelfont={bf,color=bkblue},format=hang}
\RequirePackage{enumitem}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,decorations.pathmorphing,circuits.ee.IEC}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots}
\RequirePackage{imakeidx}
% index removed
\RequirePackage[numbers,sort&compress]{natbib}

% Palette
\definecolor{bkblue}{RGB}{16,72,122}
\definecolor{bkteal}{RGB}{0,128,128}
\definecolor{bkorange}{RGB}{214,110,20}
\definecolor{bkgreen}{RGB}{40,120,60}
\definecolor{bkgray}{RGB}{90,90,90}

% Chapter and section headings
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\color{bkblue}}
  {\filleft\sffamily\fontsize{14}{16}\selectfont\scshape\color{bkgray}Chapter\hspace{0.4em}{\fontsize{60}{60}\selectfont\color{bkteal}\thechapter}}
  {6pt}
  {\titlerule[1.5pt]\vspace{8pt}\filright\sffamily\bfseries\fontsize{26}{30}\selectfont}
  [\vspace{4pt}{\color{bkteal}\titlerule[0.6pt]}]
\titlespacing*{\chapter}{0pt}{-10pt}{36pt}
\titleformat{\section}{\sffamily\Large\bfseries\color{bkblue}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\sffamily\large\bfseries\color{bkteal}}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\sffamily\normalsize\bfseries\color{bkgray}}{\thesubsubsection}{0.8em}{}
\titleformat{\part}[display]{\centering\sffamily\color{bkblue}}{\Large\scshape Part \thepart}{14pt}{\fontsize{32}{38}\selectfont\bfseries}

% Running heads
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{\ifnum\value{chapter}>0 \thechapter.\ \fi#1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ #1}}
\fancyhead[LE]{\sffamily\small\color{bkgray}\leftmark}
\fancyhead[RO]{\sffamily\small\color{bkgray}\rightmark}
\fancyfoot[LE,RO]{\sffamily\small\bfseries\color{bkblue}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{{\color{bkteal}\hrule width\headwidth height\headrulewidth}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[LE,RO]{\sffamily\small\bfseries\color{bkblue}\thepage}\renewcommand{\headrulewidth}{0pt}}

% Pedagogical boxes
\RequirePackage[most]{tcolorbox}
\tcbset{bkbase/.style={enhanced,breakable,boxrule=0.6pt,arc=2pt,left=8pt,right=8pt,top=6pt,bottom=6pt,fonttitle=\sffamily\bfseries}}
\newtcolorbox{objectives}{bkbase,colback=bkblue!5,colframe=bkblue,title=Learning Objectives}
\newtcolorbox{keyequation}[1][]{bkbase,colback=bkteal!6,colframe=bkteal,title={Key Equation#1}}
\newtcolorbox{clinicalpearl}{bkbase,colback=bkorange!7,colframe=bkorange,title=Clinical Pearl}
\newtcolorbox{simnote}{bkbase,colback=bkgreen!6,colframe=bkgreen,title=In the Simulator}
\newcounter{example}[chapter]
\renewcommand{\theexample}{\thechapter.\arabic{example}}
\newtcolorbox{example}[1]{bkbase,colback=white,colframe=bkgray,coltitle=white,colbacktitle=bkgray,title={\refstepcounter{example}Worked Example \theexample: #1}}
\newtcolorbox{authornote}{bkbase,colback=gray!6,colframe=bkgray,title=Author's Commentary}
\newtcolorbox{summarybox}{bkbase,colback=bkblue!4,colframe=bkblue!70,title=Chapter Summary}

\RequirePackage[hidelinks,bookmarksnumbered]{hyperref}
\RequirePackage[capitalise,noabbrev]{cleveref}

% Notation helpers
\newcommand{\Paw}{P_{\mathrm{aw}}}
\newcommand{\Palv}{P_{\mathrm{alv}}}
\newcommand{\Pmus}{P_{\mathrm{mus}}}
\newcommand{\PEEP}{\mathrm{PEEP}}
\newcommand{\Vdot}{\dot{V}}
\newcommand{\VT}{V_{\mathrm{T}}}
\newcommand{\Rrs}{R_{\mathrm{rs}}}
\newcommand{\Crs}{C_{\mathrm{rs}}}
\newcommand{\Ers}{E_{\mathrm{rs}}}
\newcommand{\dd}{\,\mathrm{d}}
\RequirePackage{longtable}
\endinput
